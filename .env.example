# Environment Variables for Playwright Tests
# Copy this file to .env and fill in your values

# Test Environment Configuration
TEST_ENV=staging
BASE_URL=https://www.saucedemo.com

# Test Credentials (SauceDemo)
STANDARD_USER=standard_user
STANDARD_PASSWORD=secret_sauce
LOCKED_USER=locked_out_user
PROBLEM_USER=problem_user
PERFORMANCE_USER=performance_glitch_user

# Browser Configuration
BROWSER=chromium
HEADLESS=true
SLOW_MO=0

# Test Execution
RETRIES=2
WORKERS=4
TIMEOUT=30000

# Reporting
REPORT_DIR=playwright-report
RESULTS_DIR=test-results

# CI/CD Configuration
CI=false
GITHUB_ACTIONS=false

# Optional: External Services
# LAMBDATEST_USERNAME=your_username
# LAMBDATEST_ACCESS_KEY=your_access_key
# LAMBDATEST_GRID_URL=https://hub.lambdatest.com/wd/hub

# Optional: Slack/Webhook Notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# Optional: TestRail/Jira Integration
# TESTRAIL_URL=https://yourcompany.testrail.com
# TESTRAIL_USERNAME=your_username
# TESTRAIL_API_KEY=your_api_key

# Optional: Database Configuration (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=test_db
# DB_USER=test_user
# DB_PASSWORD=test_password